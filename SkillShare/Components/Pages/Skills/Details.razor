@page "/skills/{Id:guid}"
@rendermode InteractiveServer
@inject SkillService SkillService
@inject NavigationManager Nav

@if (skill is null) { <p>Skill not found.</p> }
else
{
    <h1>@skill.Title</h1>
    <p class="text-muted">@skill.Category?.Name</p>
    <p>@skill.Description</p>

    @* TODO(auth): show these only to the owner *@
    <a class="btn btn-secondary" href="skills/edit/@skill.Id">Edit</a>
    @if (!confirmDelete)
    {
        <button class="btn btn-danger" @onclick="() => confirmDelete = true">Delete</button>
    }
    else
    {
        <span>Are you sure?</span>
        <button class="btn btn-danger" @onclick="DeleteSkill">Yes, delete</button>
        <button class="btn btn-light" @onclick="() => confirmDelete = false">Cancel</button>
    }
}
<p class="mt-3"><a href="skills">Back to list</a></p>

@code {
    [Parameter] public Guid Id { get; set; }
    private Skill? skill;
    private bool confirmDelete;

    protected override async Task OnInitializedAsync() => skill = await SkillService.GetByIdAsync(Id);

    private async Task DeleteSkill()
    {
        await SkillService.DeleteAsync(Id);
        Nav.NavigateTo("skills");
    }
}
